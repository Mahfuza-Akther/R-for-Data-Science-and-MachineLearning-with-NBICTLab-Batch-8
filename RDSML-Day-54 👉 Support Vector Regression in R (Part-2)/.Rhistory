setwd("~/Desktop/GitHub practice/R-for-Data-Science-and-MachineLearning-with-NBICTLab-Batch-8/RDSML-Day-54 👉 Support Vector Regression in R (Part-2)")
library(e1071)
library(ggplot2)
library(dplyr)
dataset <- read.csv("day.csv")
bike <- dataset %>%
select(cnt, temp, atemp, hum, windspeed, season, yr, mnth, holiday,
weekday, workingday, weathersit)
str(bike)
bike <- bike %>%
mutate(
season = factor(season),
yr = factor(yr),
mnth = factor(mnth),
holiday = factor(holiday),
weekday = factor(weekday),
workingday = factor(workingday),
weathersit = factor(weathersit)
)
set.seed(123)
n <- nrow(bike)
n
indices <- seq_len(n)
train_idx <- sample(indices, size = 0.7 * n)
train_idx
train_set <- bike[train_idx, ]
# Identify numeric predictors
num_col <-  c("temp", "atemp", "hum", "windspeed")
num_col
# Identify numeric predictors
num_cols <-  c("temp", "atemp", "hum", "windspeed")
num_cols
#Compute scaling parameter on training data
train_means <- sapply(train_set[, num_col], means)
#Compute scaling parameter on training data
train_means <- sapply(train_set[, num_col], mean)
train_means
train_sds <- sapply(train_set[, num_col], sd)
train_sds
scale_num <- function(df){
df[, num_cols] <- sweep(df[, num_col], 2, train_means, "-")
df[, num_cols] <- sweep(df[, num_col], 2, train_sds, "/")
df
}
train_scaled <- scale_num(train_set)
View(train_scaled)
View(train_scaled)
